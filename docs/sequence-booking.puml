@startuml
actor User
participant Main
participant TravelBookingFacade as Facade
participant FlightService
participant HotelService
participant CarRentalService
participant CheapestOfferStrategy as Strategy
participant TripBuilder as Builder
participant FlightBookingCreator as Factory
participant Booking
participant PendingState as State

User -> Main: Select "Build and book a trip"
Main -> Facade: findOffers(origin, destination, city, strategy)
Facade -> FlightService: search(origin, destination)
FlightService --> Facade: flights
Facade -> HotelService: search(city)
HotelService --> Facade: hotels
Facade -> CarRentalService: search(city)
CarRentalService --> Facade: cars
Facade -> Builder: build compatible combinations
Builder --> Facade: TravelPackages
Facade -> Strategy: rank(offers)
Strategy --> Facade: sorted offers
Facade --> Main: offers
User -> Main: Select offer
Main -> Facade: book(creator, description)
Facade -> Factory: createBooking(description)
Factory --> Facade: Booking(PENDING)
Facade --> Main: Booking
User -> Main: Confirm
Main -> Booking: confirm()
Booking -> State: confirm(booking)
State --> Booking: set ConfirmedState
@enduml
